{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-lifelog.org/schemas/envelope/1.0",
  "title": "OLF envelope",
  "type": "object",
  "required": ["id", "type", "olf_version", "occurred_at", "recorded_at", "source", "payload"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]*|x(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?){2,})$"
    },
    "olf_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "tz": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "payload": { "type": "object" }
  }
}
